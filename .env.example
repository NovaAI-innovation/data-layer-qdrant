# data-layer-qdrant — non-secret env template
# Production deployments: replace placeholders with real values via Secret manager
# or runtime injection. Do NOT commit real secrets.

# Qdrant server
DATA_LAYER_QDRANT_URL=http://localhost:6333
DATA_LAYER_QDRANT_API_KEY=

# Collections
COLLECTION_MPG_SOT=mpg_source_authority_documents
COLLECTION_MPG_EMAILS=mpg_emails

# Embedding model (768-dim cosine)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768
EMBEDDING_DISTANCE=Cosine

# Source authority fixture (for the seed pipeline)
DATA_LAYER_SOT_FIXTURE_CSV=/a0/usr/workdir/MPG_DBSS_E2E_V03/MPG_DBSS_SOURCE_AUTHORITY_CONTROLLED_FIXTURE_v03.csv

# Postgres FK target (the emails table lives in data-layer-postgres)
DATA_LAYER_POSTGRES_DSN=postgresql://postgres@localhost:5432/postgres

# MCP install-mode gate (set to '1' only during install/seed; NEVER in production)
MCP_INSTALL_MODE=
